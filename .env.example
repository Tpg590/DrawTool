# ================================
# Image Generation Provider
# ================================
# Options: bridge | openai | gemini
IMAGE_PROVIDER=bridge

# For "bridge" (e.g. local gpt-image-bridge) or custom endpoint:
IMAGE_API_URL=http://127.0.0.1:8080/v1/images/generations
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Examples for Gemini (direct API, no bridge needed) / OpenAI:
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# IMAGE_MODEL=gemini-2.5-flash-image
# (or Imagen: IMAGE_MODEL=imagen-3.0-generate-002)
#
# IMAGE_PROVIDER=openai
# IMAGE_API_URL=https://api.openai.com/v1/images/generations
# IMAGE_API_KEY=sk-...
# IMAGE_MODEL=gpt-image-1

# ================================
# Prompt Optimizer LLM (Optional)
# ================================
# Set to "none" to spend 0 LLM tokens (deterministic prompt optimization only).
# Options: none | openai | gemini
LLM_PROVIDER=none
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ================================
# Aseprite CLI & Tool Defaults
# ================================
# Absolute path to Aseprite executable if not on PATH
# Example Windows: C:\Program Files\Aseprite\Aseprite.exe
# Example Steam:   C:\Program Files (x86)\Steam\steamapps\common\Aseprite\Aseprite.exe
ASEPRITE_PATH=

DEFAULT_STYLE=8bit-topdown
CACHE_DIR=.cache
OUTPUT_DIR=output
